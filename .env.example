# ---- MetaTrader 5 (Deriv) ----
# Full path to terminal64.exe. Leave blank to auto-detect common install folders.
MT5_PATH=
# OPTIONAL: If left blank, uses the terminal's last logged-in account (must be running/already logged in).
# If filled, the bot will log in with these credentials.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ---- Groq ----
GROQ_API_KEY=
# Verified default. Change if Groq retires it (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss models). Ignored for models that do not support it.
GROQ_REASONING_EFFORT=medium

# ---- Safety ----
DEMO_ONLY=true
# Always starts from this value. Turn on in the dashboard once you trust the setup.
AUTO_TRADING=false

# ---- Optional ----
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
POLL_SECONDS=3